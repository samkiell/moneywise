# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/moneywise?retryWrites=true&w=majority
MONGODB_DB_NAME=moneywise

# Auth.js / NextAuth
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Seed Configuration (Development)
SEED_ADMIN_EMAIL=admin@oaucowrywise.org
SEED_ADMIN_PASSWORD=your_dev_admin_password_min_8_chars

# Playwright E2E Test Credentials (Optional - defaults to seed admin if omitted)
TEST_ADMIN_EMAIL=admin@oaucowrywise.org
TEST_ADMIN_PASSWORD=your_dev_admin_password_min_8_chars
